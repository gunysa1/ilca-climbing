{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    // src/lib files the edge functions import (Deno) name their imports with the extension
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["src", "apps", "vite.config.ts", "vitest.config.ts"]
}
