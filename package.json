{
  "name": "ilca-climbing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode viewer",
    "build": "tsc -p . && vite build --mode viewer && vite build --mode staff",
    "preview": "vite preview --mode viewer",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:db": "supabase/tests/run.sh",
    "test:e2e": "e2e/run.sh",
    "dev:staff": "vite --mode staff",
    "build:viewer": "tsc -p . && vite build --mode viewer",
    "build:staff": "tsc -p . && vite build --mode staff",
    "preview:staff": "vite preview --mode staff"
  },
  "dependencies": {
    "@supabase/postgrest-js": "2.117.2",
    "@supabase/realtime-js": "2.117.2",
    "@supabase/supabase-js": "2.117.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
